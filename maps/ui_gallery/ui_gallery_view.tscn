[gd_scene format=3]

[node name="UiGalleryView" type="Control"]
layout_mode = 3

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.02, 0.02, 0.03, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(840, 0)
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_type_variation = &"UiTitle"
text = "UI component gallery"

[node name="Intro" type="Label" parent="Center/Content"]
layout_mode = 2
theme_type_variation = &"UiBody"
text = "Shared styles, reusable scenes and explicit input ownership."

[node name="Cards" type="VBoxContainer" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="Popup" type="Button" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
mouse_force_pass_scroll_events = false
theme_type_variation = &"UiButton"
text = "Open confirmation dialog"

[node name="Status" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiMuted"
text = "Hover or click a choice; open a dialog to test input ownership."
