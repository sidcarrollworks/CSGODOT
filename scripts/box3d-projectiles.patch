+Dictionary Box3DWorld::shape_cast_projectile_box(const Vector3 &p_from, const Vector3 &p_to, const Vector3 &p_size, double p_slop, uint64_t p_mask, uint64_t p_layer) {
+	join_async_step();
+	// The upstream query recording format has no per-query tolerance field.
+	ERR_FAIL_COND_V_MSG(is_recording(), Dictionary(), "Projectile casts cannot use upstream query recording.");
+	ERR_FAIL_COND_V_MSG(!(p_slop > 0.0 && p_slop <= 0.005), Dictionary(), "Projectile slop must be in (0, 0.005] metres.");
+	Dictionary result;
+	ensure_world();
+	if (!b3World_IsValid(world_id)) {
+		result["hit"] = false;
+		return result;
+	}
+	b3Vec3 points[8];
+	fill_box_proxy(points, p_size);
+	b3ShapeProxy proxy;
+	proxy.points = points;
+	proxy.count = 8;
+	proxy.radius = 0.0f;
+	b3QueryFilter filter = b3DefaultQueryFilter();
+	filter.maskBits = p_mask;
+	filter.categoryBits = p_layer;
+	CastContext ctx;
+	ctx.world = this;
+	last_query_stats = b3World_CastShapeWithSlop(world_id, to_b3_pos(p_from), &proxy, to_b3(p_to - p_from), (float)p_slop, filter, cast_result_cb, &ctx);
+	if (ctx.hit) {
+		result["hit"] = true;
+		result["position"] = to_gd_pos(ctx.point);
+		result["normal"] = to_gd(ctx.normal);
+		result["fraction"] = ctx.fraction;
+		result["blocked_start"] = ctx.fraction == 0.0f && ctx.normal.x == 0.0f && ctx.normal.y == 0.0f && ctx.normal.z == 0.0f;
+		if (ctx.body != nullptr) {
+			result["collider"] = static_cast<Object *>(ctx.body);
+		}
+	} else {
+		result["hit"] = false;
+	}
+	return result;
+}
