# Godot
.godot/
__pycache__/
.import/
export.cfg
export_presets.cfg
*.translation

# Extracted CS2 content - never commit Valve assets.
# See reference/asset-pipeline.md for how to regenerate this directory.
assets/

# Generated reports, for pasting rather than committing
map-report.txt
# Source2Viewer-CLI leaves this wherever it was run from when a file trips it up
exceptions.txt
inspect-output.txt

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Godot docs fetched by scripts/godot_docs.sh
.godot-docs/

# CS2 sound event text fetched by scripts/sound_events.sh
.gametracking-cs2/

# Box3D experiment: reproducibly installed by scripts/install_box3d.ps1.
addons/box3d/bin/
addons/box3d/icons/*.import

# The game's native code, built by scripts/build_native.sh and .ps1.
addons/csgodot_native/
native/build/
native/.sconsign.dblite
