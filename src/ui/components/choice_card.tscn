[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/components/choice_card.gd" id="1"]

[node name="ChoiceCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 120)
mouse_filter = 2
theme_type_variation = &"UiCard"
script = ExtResource("1")

[node name="Action" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
mouse_force_pass_scroll_events = false
theme_type_variation = &"UiButton"

[node name="Padding" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 18

[node name="Text" type="VBoxContainer" parent="Padding"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Padding/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiHeading"
clip_text = true

[node name="Description" type="Label" parent="Padding/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiBody"
autowrap_mode = 2
