[gd_scene format=3]

[node name="ModePickerView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_force_pass_scroll_events = false

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.02, 0.02, 0.03, 0.92)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(840, 0)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_type_variation = &"UiTitle"
text = "Choose a game mode"
horizontal_alignment = 1

[node name="Choices" type="VBoxContainer" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Hint" type="Label" parent="Center/Content"]
layout_mode = 2
theme_type_variation = &"UiMuted"
text = "1 or 2, click, or use arrows and Enter to choose."
horizontal_alignment = 1
